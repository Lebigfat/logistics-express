{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^u-(.*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/index/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/send/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/coupon/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/address/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/express/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/life/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom",
        "disableScroll": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "寄速递",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#f5f7fb",
    "backgroundTextStyle": "light"
  },
  "tabBar": {
    "color": "#b7beca",
    "selectedColor": "#3d8bff",
    "backgroundColor": "#ffffff",
    "borderStyle": "white",
    "height": "58px",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "寄快递",
        "iconPath": "static/tabbar/send.png",
        "selectedIconPath": "static/tabbar/send-active.png"
      },
      {
        "pagePath": "pages/express/index",
        "text": "查快递",
        "iconPath": "static/tabbar/search.png",
        "selectedIconPath": "static/tabbar/search-active.png"
      },
      {
        "pagePath": "pages/life/index",
        "text": "生活服务",
        "iconPath": "static/tabbar/life.png",
        "selectedIconPath": "static/tabbar/life-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tabbar/profile.png",
        "selectedIconPath": "static/tabbar/profile-active.png"
      }
    ]
  }
}
